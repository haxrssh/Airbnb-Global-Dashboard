# Normalise line endings so diffs stay clean across Windows/macOS/Linux
* text=auto

*.tmdl      text eol=crlf
*.json      text eol=crlf
*.pbir      text eol=crlf
*.pbism     text eol=crlf
*.pbip      text eol=crlf
*.platform  text eol=crlf

*.png binary
*.jpg binary

# Optional: if you ever decide to commit the .pbix itself, track it with Git LFS:
#   git lfs install && git lfs track "*.pbix"
# and remove "*.pbix" from .gitignore.
