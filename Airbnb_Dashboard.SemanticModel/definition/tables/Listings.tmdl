table Listings
	lineageTag: 6716d343-105d-4eb8-a9c1-c7b323910469

	measure 'Entire Place' =
			CALCULATE (
			    COUNT ( Listings[listing_id] ),
			     Listings[room_type] = "Entire place"
			)
		formatString: 0
		lineageTag: 6bb48d4c-67b7-412a-b5f4-bcd00941164c

	measure 'Hotel room' =
			CALCULATE (
			    COUNT ( Listings[listing_id] ),
			     Listings[room_type] = "Hotel room"
			)
		formatString: 0
		lineageTag: 89c49962-c0e6-48dd-a09d-f28f0f0582b1

	measure 'Private Room' =
			CALCULATE (
			    COUNT ( Listings[listing_id] ),
			     Listings[room_type] = "Private room"
			)
		formatString: 0
		lineageTag: 3ffd04fb-1224-4d72-948d-788d26367522

	measure 'Shared room' =
			CALCULATE (
			    COUNT ( Listings[listing_id] ),
			     Listings[room_type] = "Shared room"
			)
		formatString: 0
		lineageTag: a69ca84a-966a-4d37-8fa0-56c2b24eb915

	measure 'Total Listings' = DISTINCTCOUNT(Listings[listing_id])
		formatString: 0
		lineageTag: 37c0b547-1743-490d-96a5-120d9ca0025c

	measure 'Superhost Listings' =
			CALCULATE(
			    COUNT(Listings[listing_id]),
			    Listings[host_is_superhost] = "t"
			)
		formatString: 0
		lineageTag: b1235b16-1ae4-4d21-bdb3-0453b21fa4e8

	measure 'No Superhost Listings' =
			CALCULATE(
			    COUNT(Listings[listing_id]),
			    Listings[host_is_superhost] = "f"
			)
		formatString: 0
		lineageTag: de74b401-9230-4371-b751-945c8aea4245

	measure 'City Rank' =
			RANKX (
			    ALL (Listings[city] ),
			    [Total Listings],
			    ,DESC
			)
		formatString: 0
		lineageTag: 34943379-0496-4cca-b76d-b77ef9d154dc

	measure 'Cumulative Listings' =
			VAR CurrentRank =
			MAXX ( 
			    VALUES(Listings[city]),
			    [City Rank]
			
			)
			RETURN
			CALCULATE (
			    [Total Listings],
			    FILTER(
			        ALL(Listings[city]),
			        [City Rank] <= CurrentRank
			    )
			)
		formatString: 0
		lineageTag: 5ebb0815-f68d-47e1-9745-abf683f2fb8e

	measure 'Cumulative %' =
			DIVIDE( [Cumulative Listings], CALCULATE([Total Listings], ALL(Listings[city]))
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e99eac99-f2e9-4d8f-abd3-65697ca11d1e

	measure 'Avg Price' = AVERAGE(Listings[price])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: d9b6f1e9-b955-4e01-8938-738ab47fe637

	measure 'Avg Rating' = AVERAGE( Listings[review_scores_rating] )
		formatString: 0.0
		lineageTag: ce2559a8-0887-449d-821d-d48a11c784c9

	measure Accuracy = AVERAGE( Listings[review_scores_accuracy] )
		lineageTag: bca14ecc-2d31-4f81-8ace-bd56933c1003

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Cleanliness = AVERAGE(Listings[review_scores_cleanliness] )
		lineageTag: c6499565-0275-4865-b427-5034fde33ad1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure location = AVERAGE( Listings[review_scores_location] )
		lineageTag: 394016a5-f3e0-4efa-a26d-715c59d9f5e8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Value = AVERAGE(Listings[review_scores_value] )
		lineageTag: 790add97-b9b6-43de-81e2-2b13d4c32599

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Revivewers' = COUNT(Reviews[reviewer_id])
		formatString: 0
		lineageTag: c4a3b42e-4a39-4df4-9220-639de58d3fdc

	measure 'Total Hosts' = DISTINCTCOUNT(Listings[host_id])
		formatString: 0
		lineageTag: 3b075f3e-311e-414c-aa1e-a291238bd30e

	measure 'Listings per host' = DIVIDE([Total Listings], [Total Hosts])
		formatString: 0.00
		lineageTag: 4edda8b9-a588-4565-b804-cdb14e2015f9

	measure 'Top 3 City Listings Share %' =
			VAR CityTable =
			    ADDCOLUMNS(
			        ALLSELECTED(Listings[city]),
			        "@Listings", CALCULATE([Total Listings])
			    )
			VAR TopCities =
			    TOPN(
			        3,
			        CityTable,
			        [@Listings], DESC,
			        Listings[city], ASC
			    )
			VAR Top3Listings =
			    SUMX(TopCities, [@Listings])
			VAR AllCityListings =
			    CALCULATE(
			        [Total Listings],
			        ALLSELECTED(Listings[city])
			    )
			RETURN
			    DIVIDE(Top3Listings, AllCityListings)
		lineageTag: aee40b4c-24aa-412b-9b30-83cd61dc70f8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

